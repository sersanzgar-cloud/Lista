# Copy this file to ".env" and fill in your Supabase project's public
# credentials (Project Settings -> API in supabase.com) to enable sign-in
# and cloud sync of your library and reading progress across devices.
#
# Both values below are PUBLIC and safe to ship in a browser bundle —
# access to your data is controlled by the Row Level Security policies in
# supabase/schema.sql, not by keeping these secret.
#
# Leaving this file absent (or these values empty) is fine: Lista falls
# back to storing everything in this browser only (localStorage).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
